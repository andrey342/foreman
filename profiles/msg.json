{
  "version": 1,
  "runsDir": ".agents/runs",
  "claudeExe": null,
  "isolation": "none",
  "repos": [
    { "name": "MSG", "path": "." },
    { "name": "Backend", "path": "MicroservicesGenerator-backend" },
    { "name": "Frontend", "path": "MicroservicesGenerator-frontend" }
  ],
  "roles": {
    "implementer": {
      "model": "opus",
      "effort": "high",
      "permissionMode": "auto",
      "byLevel": { "N1": { "model": "sonnet" } },
      "skills": ["msg-implement-plan", "msg-run-state"],
      "extra": "Raíz canónica C:\\MSG. Backend: gitnexus_impact antes de tocar .cs."
    },
    "reviewer": {
      "model": "fable",
      "effort": "high",
      "kind": "subagent",
      "tools": ["Read", "Grep", "Glob", "Bash", "Write"],
      "skills": ["msg-back-review", "msg-front-code-review"],
      "contract": "prompts/reviewer.md"
    },
    "critic": { "model": "fable", "effort": "high", "kind": "subagent", "skills": ["msg-independent-acceptance"] },
    "qa": { "model": "sonnet", "effort": "medium", "skills": ["msg-qa-tester"] },
    "planner": { "model": "opus", "effort": "high", "skills": ["msg-planning"] }
  },
  "gates": {
    "backend": ["powershell.exe -NoProfile -File scripts/test-backend-conventions.ps1"],
    "frontend": ["npm run lint"]
  },
  "guards": [
    {
      "when": { "tool": "Edit|Write|MultiEdit", "pathGlob": "**/*.cs" },
      "requireToolCalledBefore": "mcp__gitnexus__impact",
      "mode": "warn",
      "reason": "Regla MSG (CLAUDE.md / AGENTS.md §8): impacto de GitNexus antes de editar un .cs del backend"
    },
    {
      "when": { "tool": "Bash|PowerShell", "commandRegex": "\\bgit\\b[\\s\\S]*\\bcommit\\b" },
      "requireToolCalledBefore": "mcp__gitnexus__detect_changes",
      "mode": "warn",
      "reason": "Regla MSG (CLAUDE.md / AGENTS.md §8): detect_changes de GitNexus antes de commitear cambios del backend"
    },
    {
      "when": { "tool": "Bash|PowerShell", "commandRegex": "git\\s+add\\s+(?:-A|--all|\\.)(?:\\s|$)" },
      "mode": "deny",
      "reason": "Rutas explícitas, nunca git add -A"
    }
  ],
  "limits": { "maxParallelThreads": 1, "maxReviewCycles": 2, "serialBuilds": true },
  "hooks": {
    "onRunCreate": "powershell.exe -NoProfile -File .agents/skills/msg-run-state/scripts/new-run.ps1 -RunId {{runId}} -Repos MSG,Backend,Frontend -JoinBranch"
  },
  "injectHandoff": false,
  "notify": { "toast": true, "command": null }
}
